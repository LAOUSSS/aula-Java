public class Produto {
    
    String nome;
    double preco;
    int quantidade;
    
    public void exibirDados () {
        System.out.println("\n nome do produto : "  + nome  + "\n preço do produto : "  + preco  + "\n quantidade do produto : " + quantidade);
    }
    public void calcularTotal () {
        System.out.println("\n Tempos um  total de " + preco*quantidade + " reais no produto : " + nome);
    }
}



public class Main
{
	public static void main(String[] args) {
		
	
    Produto produto1 = new Produto ();
    
    produto1.nome = "arroz";
    produto1.preco = 5.5;
    produto1.quantidade = 10;
    
    produto1.exibirDados();
    produto1.calcularTotal();
    
    Produto produto2 = new Produto ();
    
    produto2.nome = "carne";
    produto2.preco = 20.50;
    produto2.quantidade = 3;
    
    produto2.exibirDados();
	produto2.calcularTotal();    
	    
	}
}
